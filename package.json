{
  "name": "nhs-cli",
  "version": "0.1.0",
  "description": "Unofficial NHS App CLI with secure persistent authentication and read access to health services.",
  "private": true,
  "type": "module",
  "bin": {
    "nhs": "bin/nhs.mjs",
    "nhs-prescriptions": "bin/nhs-prescriptions.mjs"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:keyring": "node --test test/integration/keyring.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "files": [
    "bin/",
    "src/",
    "skills/",
    "README.md",
    "LICENSE",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/"
  ],
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "tough-cookie": "6.0.2"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "7.0.2"
  }
}
