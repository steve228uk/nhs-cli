{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "strict": false,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false
  },
  "include": [
    "src/**/*.mjs",
    "bin/**/*.mjs",
    "scripts/**/*.mjs"
  ]
}
